        "jsCode": "const t = $('01_Jira_Trigger').first().json || {};\nconst issue = t.issue || t.body && t.body.issue || t;\nconst issueKey = (issue && (issue.key || issue.issueKey)) || t.key || null;\nif (!issueKey) {\n  throw new Error('Could not determine Jira issue key from the trigger payload.');\n}\nreturn [{ json: { issueKey } }];"
      },
