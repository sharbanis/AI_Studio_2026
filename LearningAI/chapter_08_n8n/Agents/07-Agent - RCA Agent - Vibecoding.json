    {
      "parameters": {
        "jsCode": "const cfg = $('02_Load_Configuration').first().json;\nconst facts = $('08_Normalize_Jira_Data').first().json.facts;\nconst existing = $('09_Search_Excel_RCA').first().json || {};\nconst NA = cfg.notAvailable;\nconst IR = cfg.investigationRequired;\n\n// AI output is wrapped under \"output\" by the parser; absent on the error branch.\nconst ai = ($json && $json.output) ? $json.output : null;\nconst aiOk = !!ai;\n\nconst j = (v) => {\n  if (v == null || v === \"\") return \"\";\n  if (Array.isArray(v)) return v.map(x => (typeof x === \"object\" ? JSON.stringify(x) : String(x))).join(\"\\n\");\n  if (typeof v === \"object\") return JSON.stringify(v, null, 2);\n  return String(v);\n};\nconst pick = (v, fallback) => (v == null || v === \"\" ? fallback : v);\n\nconst dc = (ai && ai.document_control) || {};\nconst isum = (ai && ai.incident_summary) || {};\nconst bi = (ai && ai.business_impact) || {};\nconst rc = (ai && ai.root_cause) || {};\nconst qa = (ai && ai.qa_escape_analysis) || {};\n\nconst key = facts.issue_key;\nconst nowIso = new Date().toISOString();\nconst hadExisting = !!(existing && existing[\"Jira Issue Key\"]);\nconst action = hadExisting ? \"Update\" : \"Create\";\nconst createdDate = hadExisting && existing[\"Created Date\"] ? existing[\"Created Date\"] : nowIso;\n\nconst row = {\n  \"RCA ID\": pick(dc.rca_id, \"RCA-\" + key),\n  \"Jira Issue Key\": key,\n  \"Application\": pick(dc.application_project, facts.project || NA),\n  \"Module\": pick(dc.module_feature, (facts.components || []).join(\", \") || NA),\n  \"Environment\": pick(dc.environment, facts.environment || NA),\n  \"Severity\": pick(dc.severity, facts.severity || NA),\n  \"Priority\": pick(dc.priority, facts.priority || NA),\n  \"Issue Summary\": facts.summary || \"\",\n  \"Problem Statement\": pick(isum.problem_statement, IR),\n  \"Expected Result\": pick(isum.expected_result, IR),\n  \"Actual Result\": pick(isum.actual_result, IR),\n  \"Business Impact\": pick(bi.business_function, NA),\n  \"Affected Users\": pick(bi.affected_users, NA),\n  \"Incident Start\": pick(dc.incident_start, facts.created || NA),\n  \"Incident End\": pick(dc.incident_end, NA),\n  \"Duration\": pick(dc.duration, NA),\n  \"Root Cause Category\": pick(rc.root_cause_category, IR),\n  \"Immediate Cause\": pick(rc.immediate_cause, IR),\n  \"Technical Root Cause\": pick(rc.technical_root_cause, IR),\n  \"Contributing Factors\": pick(j(rc.contributing_factors), IR),\n  \"5-Why Analysis\": pick(j(ai && ai.five_why), IR),\n  \"QA Escape Analysis\": pick(j(qa), IR),\n  \"Corrective Actions\": pick(j(ai && ai.corrective_actions), IR),\n  \"Preventive Actions\": pick(j(ai && ai.preventive_actions), IR),\n  \"Regression Status\": pick(j(ai && ai.regression_validation), \"Not Executed / Evidence Required\"),\n  \"RCA Status\": pick(dc.rca_status, IR),\n  \"RCA Owner\": pick(dc.rca_owner, facts.assignee || NA),\n  \"Development Owner\": pick(dc.development_owner, facts.assignee || NA),\n  \"QA Owner\": pick(dc.qa_owner, NA),\n  \"Deployment Date\": pick(dc.deployment_date, NA),\n  \"Release Version\": pick(dc.release_version, (facts.fix_versions || []).join(\", \") || NA),\n  \"Created Date\": createdDate,\n  \"Last Updated\": nowIso,\n  \"Source Jira URL\": (cfg.jiraBaseUrl ? (String(cfg.jiraBaseUrl).replace(/\\/$/, \"\") + \"/browse/\" + key) : \"\"),\n  \"Evidence / Notes\": aiOk ? \"\" : \"AI extraction failed - Jira facts only. AI-derived sections marked Investigation Required.\",\n};\n// internal metadata (ignored by the sheet via handlingExtraData: ignoreIt)\nrow._action = action;\nrow._ai_status = aiOk ? \"Success\" : \"Failed - Facts Only\";\nrow._fields_updated = String(Object.keys(row).filter(k => !k.startsWith(\"_\")).length);\nreturn [{ json: row }];"
      },
