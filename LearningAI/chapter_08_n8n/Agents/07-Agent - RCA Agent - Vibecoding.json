    {
      "parameters": {
        "jsCode": "const items = $input.all().filter(i => i.json && Object.keys(i.json).length > 0);\nconst strip = (html) => String(html == null ? \"\" : html).replace(/<[^>]+>/g, \" \").replace(/&nbsp;/g, \" \").replace(/\\s+/g, \" \").trim();\nconst comments = items.map(i => ({\n  id: i.json.id || \"\",\n  author: (i.json.author && i.json.author.displayName) || \"\",\n  created: i.json.created || \"\",\n  body: strip(i.json.renderedBody || (typeof i.json.body === \"string\" ? i.json.body : \"\")),\n}));\nreturn [{ json: { comments } }];"
      },
      "id": "9d69e7fc-ab24-49c0-91d5-a451b1fbf2cd",
      "name": "07_Aggregate_Comments",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        976,
        -64
      ]
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('02_Load_Configuration').first().json;\nconst issue = $('04_Get_Jira_Issue').first().json;\nconst comments = ($json.comments) || [];\nconst f = (issue && issue.fields) || {};\n\nconst strip = (html) => String(html == null ? \"\" : html).replace(/<[^>]+>/g, \" \").replace(/&nbsp;/g, \" \").replace(/\\s+/g, \" \").trim();\n\n// Normalize description: prefer rendered HTML, then plain, then ADF text.\nlet description = \"\";\nif (issue.renderedFields && issue.renderedFields.description) {\n  description = strip(issue.renderedFields.description);\n} else if (typeof f.description === \"string\") {\n  description = f.description;\n} else if (f.description && f.description.content) {\n  const walk = (n) => {\n    let out = \"\";\n    if (n.text) out += n.text;\n    if (Array.isArray(n.content)) out += n.content.map(walk).join(\" \");\n    return out;\n  };\n  description = walk(f.description);\n}\n\n// Mask obvious secrets before anything is sent to the AI.\nconst mask = (s) => String(s == null ? \"\" : s)\n  .replace(/(password|passwd|pwd|secret|api[-_ ]?key|token|authorization|bearer)\\s*[:=]\\s*\\S+/gi, \"$1: [REDACTED]\")\n  .replace(/eyJ[A-Za-z0-9_\\-]+\\.[A-Za-z0-9_\\-]+\\.[A-Za-z0-9_\\-]+/g, \"[REDACTED_JWT]\");\n\nconst nameOf = (u) => (u && (u.displayName || u.name)) || \"\";\n\nconst facts = {\n  issue_key: issue.key || \"\",\n  issue_id: issue.id || \"\",\n  summary: mask(f.summary || \"\"),\n  description: mask(description),\n  issue_type: (f.issuetype && f.issuetype.name) || \"\",\n  status: (f.status && f.status.name) || \"\",\n  status_category: (f.status && f.status.statusCategory && f.status.statusCategory.name) || \"\",\n  priority: (f.priority && f.priority.name) || \"\",\n  severity: (cfg.severityFieldId && f[cfg.severityFieldId] && (f[cfg.severityFieldId].value || f[cfg.severityFieldId].name)) || (typeof (f[cfg.severityFieldId]) === \"string\" ? f[cfg.severityFieldId] : \"\"),\n  reporter: nameOf(f.reporter),\n  assignee: nameOf(f.assignee),\n  created: f.created || \"\",\n  updated: f.updated || \"\",\n  resolutiondate: f.resolutiondate || \"\",\n  duedate: f.duedate || \"\",\n  project: (f.project && (f.project.name || f.project.key)) || \"\",\n  components: (f.components || []).map(c => c.name),\n  labels: f.labels || [],\n  environment: (f.environment ? String(f.environment) : \"\"),\n  fix_versions: (f.fixVersions || []).map(v => v.name),\n  affected_versions: (f.versions || []).map(v => v.name),\n  parent: (f.parent && f.parent.key) || \"\",\n  subtasks: (f.subtasks || []).map(s => ({ key: s.key, summary: s.fields && s.fields.summary })),\n  linked_issues: (f.issuelinks || []).map(l => ({\n    type: l.type && (l.type.outward || l.type.inward || l.type.name),\n    key: (l.outwardIssue && l.outwardIssue.key) || (l.inwardIssue && l.inwardIssue.key) || \"\",\n    summary: (l.outwardIssue && l.outwardIssue.fields && l.outwardIssue.fields.summary) || (l.inwardIssue && l.inwardIssue.fields && l.inwardIssue.fields.summary) || \"\",\n  })),\n  worklogs: ((f.worklog && f.worklog.worklogs) || []).map(w => ({ author: nameOf(w.author), created: w.created, timeSpent: w.timeSpent, comment: mask(typeof w.comment === \"string\" ? w.comment : \"\") })),\n  comments: comments.map(c => ({ author: c.author, created: c.created, body: mask(c.body) })),\n};\n\nconst ai_payload = JSON.stringify(facts, null, 2);\nreturn [{ json: { facts, ai_payload, issueKey: facts.issue_key } }];"
      },
