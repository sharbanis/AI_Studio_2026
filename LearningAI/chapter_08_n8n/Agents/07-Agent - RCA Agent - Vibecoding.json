      "id": "7a0b47c7-e553-4c3a-a0f5-354455f9b212",
      "name": "RCA_Output_Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1888,
        64
      ]
